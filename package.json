{
  "name": "bkb-tms",
  "version": "1.0.0",
  "description": "BKB Office Automation Suite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "better-sqlite3": "^11.3.0",
    "decimal.js": "^10.6.0",
    "electron-store": "^11.0.2",
    "fs-extra": "^11.2.0",
    "jsdom": "^29.1.1",
    "jspdf": "^2.5.1",
    "node-machine-id": "^1.1.12",
    "pg": "^8.22.0",
    "piscina": "^5.3.0",
    "roarr": "^7.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.1"
  },
  "build": {
    "appId": "com.bkb.tms",
    "productName": "BKB TMS",
    "icon": "assets/images/launch_icon.ico",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh"
    }
  }
}
